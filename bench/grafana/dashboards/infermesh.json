  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate (by gateway status)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "sum by (status) (rate(infermesh_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"]}}
    },
    {
      "type": "timeseries",
      "title": "Request rate (by model)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "targets": [
        {
          "expr": "sum by (model) (rate(infermesh_requests_total[1m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"]}}
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request latency percentiles",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(infermesh_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(infermesh_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(infermesh_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "type": "timeseries",
      "title": "Routing decision time (per router)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, router) (rate(infermesh_routing_decision_seconds_bucket[1m])))",
          "legendFormat": "{{router}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, router) (rate(infermesh_routing_decision_seconds_bucket[1m])))",
          "legendFormat": "{{router}} p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "decimals": 5}
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "type": "row",
      "title": "KV cache routing",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Trie entries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 19},
      "targets": [{"expr": "infermesh_trie_entries", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}}
    },
    {
      "type": "stat",
      "title": "Active sessions",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 19},
      "targets": [{"expr": "infermesh_active_sessions", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "stat",
      "title": "Cache hit rate (5m)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 19},
      "targets": [
        {
          "expr": "sum(rate(infermesh_kv_cache_hits_total[5m])) / clamp_min(sum(rate(infermesh_kv_cache_hits_total[5m])) + sum(rate(infermesh_kv_cache_misses_total[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.3},
            {"color": "green", "value": 0.6}
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "Circuit breaker opens (5m)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 19},
      "targets": [
        {
          "expr": "sum(increase(infermesh_circuit_breaker_opens_total[5m]))",
          "refId": "A"
        }
      ],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]}
        }
      }
    },
    {
      "type": "stat",
      "title": "Redis events received (5m)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 19},
      "targets": [{
        "expr": "sum(increase(infermesh_redis_events_received_total[5m]))",
        "refId": "A"
      }],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "stat",
      "title": "Redis events dropped (5m)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 19},
      "targets": [{
        "expr": "sum(increase(infermesh_redis_events_dropped_total[5m]))",
        "refId": "A"
      }],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1}
          ]}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache hit / miss rate over time",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 23},
      "targets": [
        {
          "expr": "sum by (source) (rate(infermesh_kv_cache_hits_total[1m]))",
          "legendFormat": "hits / {{source}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(infermesh_kv_cache_misses_total[1m]))",
          "legendFormat": "misses",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "sum"]}}
    },
    {
      "type": "timeseries",
      "title": "Cumulative hit rate (5m sliding)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 23},
      "targets": [
        {
          "expr": "sum(rate(infermesh_kv_cache_hits_total[5m])) / clamp_min(sum(rate(infermesh_kv_cache_hits_total[5m])) + sum(rate(infermesh_kv_cache_misses_total[5m])), 0.001)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 2,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}}
    },
